{
  "name": "camideyiz-biz",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @camideyiz/mobile",
    "android": "npm run android --workspace @camideyiz/mobile",
    "ios": "npm run ios --workspace @camideyiz/mobile",
    "admin": "npm run dev --workspace @camideyiz/admin",
    "test": "node --experimental-strip-types --test packages/core/src/*.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:release": "node scripts/verify-release-gates.mjs",
    "verify:kerahat-posters": "node scripts/verify-kerahat-posters.mjs",
    "verify:gallery-assets": "node scripts/verify-gallery-assets.mjs",
    "prepare:adhan": "node scripts/prepare-adhan-audio.mjs",
    "postinstall": "node scripts/prepare-adhan-audio.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
