<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_ring_mini_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_bg_light">
  <ImageView
    android:id="@+id/widget_ring_mini_art"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:padding="3dp"
    android:scaleType="fitCenter"
    android:contentDescription="Yayımlanmış namaz vakitlerinin süreleriyle orantılı renkli vakit halkası"/>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:paddingHorizontal="24dp"
    android:gravity="center"
    android:orientation="vertical">
    
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:gravity="center" android:text="SIRADAKİ"
      android:textSize="8sp" android:letterSpacing=".10"
      android:textColor="#65736C"
      android:includeFontPadding="false" android:maxLines="1" />
    <TextView android:id="@+id/widget_ring_mini_next" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:gravity="center"
      android:text="Takvim" android:textSize="12sp"
      android:textColor="#152821"
      android:textStyle="bold" android:includeFontPadding="false"
      android:maxLines="1" android:ellipsize="end"/>
    <Chronometer android:id="@+id/widget_ring_mini_countdown"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:text="--:--" android:textSize="16sp"
      android:textStyle="bold" android:fontFamily="sans-serif"
      android:textColor="#152821"
      android:singleLine="true" android:includeFontPadding="false"/>
    <TextView android:id="@+id/widget_ring_mini_time"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:gravity="center" android:text="--:--"
      android:layout_marginTop="2dp"
      android:textSize="9sp" android:maxLines="1"
      android:textColor="#365C78"
      android:includeFontPadding="false" />
    
  </LinearLayout>
</FrameLayout>
