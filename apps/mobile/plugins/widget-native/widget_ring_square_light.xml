<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_ring_square_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="@drawable/widget_bg" android:padding="4dp" android:orientation="vertical" android:gravity="center">
 <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/widget_brand_lockup" android:scaleType="fitCenter" android:contentDescription="Camideyiz.biz"/>
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
  android:layout_weight="1" android:layout_marginTop="1dp">
  <ImageView android:id="@+id/widget_ring_square_art" android:layout_width="match_parent"
   android:layout_height="match_parent" android:scaleType="fitCenter"
   android:contentDescription="Altı gerçek namaz vaktini gösteren kare vakit çemberi"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
   android:orientation="vertical" android:gravity="center" android:layout_gravity="center"
   android:paddingStart="10dp" android:paddingEnd="10dp">
 <TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="KALAN SÜRE" android:textSize="8sp" android:textColor="#B2C6D6" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"  />
 <Chronometer android:id="@+id/widget_ring_square_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#F2D397" android:textSize="18sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:includeFontPadding="false" android:gravity="center" android:singleLine="true"/>
 <TextView android:id="@+id/widget_ring_square_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sıradaki" android:textSize="11sp" android:textColor="#F2F7FB" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="3dp"/>
 <TextView android:id="@+id/widget_ring_square_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--:--" android:textSize="9sp" android:textColor="#B2C6D6" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"  android:layout_marginTop="2dp"/>
  </LinearLayout>
 </FrameLayout>
</LinearLayout>