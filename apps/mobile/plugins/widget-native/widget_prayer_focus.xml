<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 focus. Both columns fill the body height: the current prayer and the
     countdown autosize to their slots, so large launcher cells read as one
     confident composition instead of small text floating in empty space. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_focus_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="@drawable/widget_bg" android:padding="10dp" android:orientation="vertical">
 <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical"
  android:orientation="horizontal">
 <ImageView android:layout_width="42dp" android:layout_height="36dp" android:src="@drawable/widget_brand_mark_dark"
  android:scaleType="fitCenter" android:contentDescription="Camideyiz.biz"/>
 <LinearLayout android:id="@+id/widget_focus_dates" android:layout_width="0dp" android:layout_height="match_parent"
  android:layout_weight="1.7" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="center">
 <TextView android:id="@+id/widget_focus_hijri" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="" android:textSize="11sp" android:textColor="#F4D392" android:textStyle="bold" android:gravity="center" android:maxLines="1" android:includeFontPadding="false"/>
 <TextView android:id="@+id/widget_focus_civil" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="" android:textSize="11sp" android:textColor="#F1F7F8" android:textStyle="bold" android:gravity="center" android:maxLines="1" android:includeFontPadding="false"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_focus_city" android:layout_width="0dp" android:layout_height="wrap_content"
  android:layout_weight="1" android:layout_marginStart="6dp" android:text="Konum" android:textSize="11sp"
  android:textColor="#AFC5D4" android:gravity="end|center_vertical" android:maxLines="1"
  android:ellipsize="end" android:includeFontPadding="false"/>
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="1dp" android:text=""
  android:background="@drawable/widget_rule_dark" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginTop="5dp" android:layout_marginBottom="6dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
  android:orientation="horizontal" android:baselineAligned="false">
  <LinearLayout android:layout_width="0dp" android:layout_weight="0.85" android:layout_height="match_parent"
   android:orientation="vertical">
  <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.3"
   android:text="ŞU AN" android:textSize="9sp" android:textColor="#AFC5D4" android:gravity="start|bottom"
   android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform"
   android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"/>
  <TextView android:id="@+id/widget_focus_current" android:layout_width="match_parent" android:layout_height="0dp"
   android:layout_weight="0.9" android:text="—" android:textSize="19sp" android:textColor="#F1F7F8"
   android:textStyle="bold" android:gravity="start|center_vertical" android:maxLines="1"
   android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp"
   android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp"/>
  <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.3" android:text=""/>
  </LinearLayout>
  <TextView android:layout_width="1dp" android:layout_height="match_parent" android:text=""
   android:background="#31566D" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"
   android:layout_marginStart="4dp" android:layout_marginEnd="12dp"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1.25" android:layout_height="match_parent"
   android:orientation="vertical">
  <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.26"
   android:text="KALAN SÜRE" android:textSize="9sp" android:textColor="#3CC8F5" android:textStyle="bold" android:gravity="start|bottom"
   android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform"
   android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"/>
  <Chronometer android:id="@+id/widget_focus_countdown" android:layout_width="match_parent" android:layout_height="0dp"
   android:layout_weight="1" android:text="--:--" android:textColor="#3CC8F5" android:textSize="27sp"
   android:textStyle="bold" android:includeFontPadding="false"
   android:gravity="start|center_vertical" android:maxLines="1" android:autoSizeTextType="uniform"
   android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="56sp" android:autoSizeStepGranularity="1sp"/>
  <TextView android:id="@+id/widget_focus_next" android:layout_width="match_parent" android:layout_height="0dp"
   android:layout_weight="0.3" android:text="Sıradaki" android:textSize="10sp" android:textColor="#F1F7F8"
   android:gravity="start|center_vertical" android:maxLines="1" android:includeFontPadding="false"
   android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="15sp"
   android:autoSizeStepGranularity="1sp"/>
  <TextView android:id="@+id/widget_focus_time" android:layout_width="match_parent" android:layout_height="0dp"
   android:layout_weight="0.24" android:text="Saat --:--" android:textSize="9sp" android:textColor="#F1F7F8" android:textStyle="bold"
   android:gravity="start|top" android:maxLines="1" android:includeFontPadding="false"
   android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="13sp"
   android:autoSizeStepGranularity="1sp"/>
  </LinearLayout>
 </LinearLayout>
</LinearLayout>
