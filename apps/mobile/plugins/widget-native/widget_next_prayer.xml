<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="9dp" android:background="@drawable/widget_bg">
<LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
<ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_mark_dark" android:contentDescription="Camideyiz Biz"/>
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="Camideyiz Biz" android:textStyle="bold" android:textSize="12sp" android:textColor="#F8F4E9" android:maxLines="1"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☾" android:textSize="11sp" android:textColor="#F0CB8B"/>
</LinearLayout>
<TextView android:id="@+id/widget_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pendik · İstanbul" android:textSize="10sp" android:textColor="#C3D4CD" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="1dp"/>
<TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" android:background="#A58D61" android:text="" android:textSize="1sp" android:includeFontPadding="false" />
<TextView android:id="@+id/widget_next_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SIRADAKİ VAKİT" android:textSize="9sp" android:textColor="#C3D4CD" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:letterSpacing="0.10"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="1dp">
<TextView android:id="@+id/widget_next_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Akşam" android:layout_marginEnd="6dp" android:textColor="#F8F4E9" android:textSize="15sp" android:textStyle="bold" android:maxLines="1"/>
<TextView android:id="@+id/widget_next_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="17:51" android:textColor="#F0CB8B" android:textSize="24sp" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1"/>
</LinearLayout>
<LinearLayout android:id="@+id/widget_next_countdown_row" android:layout_width="match_parent" android:layout_height="23dp" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/widget_chip_dark">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KALAN  " android:textSize="9sp" android:textColor="#C3D4CD"/>
<Chronometer android:id="@+id/widget_next_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textSize="13sp" android:textStyle="bold" android:textColor="#F8F4E9"/>
</LinearLayout>
</LinearLayout>
