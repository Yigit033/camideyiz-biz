<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="11dp"
    android:background="@drawable/widget_bg">
    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="☪  Camideyiz Biz"
        android:textColor="#F2CE91"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widget_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Takvim bekleniyor"
        android:textSize="10sp"
        android:textColor="#BCD4DA"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widget_next_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Sıradaki vakit"
        android:textSize="10sp"
        android:textColor="#E6EDF0"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widget_next_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#F2D49D"
        android:fontFamily="sans"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Açmak için dokun"
        android:textColor="#ACCDD2"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
