<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_compact_root" android:layout_width="match_parent"
 android:layout_height="match_parent" android:orientation="vertical"
 android:gravity="center" android:padding="2dp"
 android:background="@drawable/widget_bg_light">
 <ImageView android:layout_width="18dp" android:layout_height="10dp"
  android:src="@drawable/widget_brand_symbol" android:contentDescription="Camideyiz Biz"
  android:scaleType="fitCenter"/>
 <TextView android:id="@+id/widget_compact_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Camideyiz Biz" android:textColor="#152821" android:textSize="7sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="1dp" />

 <TextView android:id="@+id/widget_compact_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Takvim" android:textColor="#65736C" android:textSize="9sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="1dp" />

 <TextView android:id="@+id/widget_compact_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--:--" android:textColor="#A88A5C" android:textSize="14sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="1dp" />

 <LinearLayout android:id="@+id/widget_compact_remaining_row"
  android:layout_width="match_parent" android:layout_height="17dp"
  android:layout_marginTop="1dp" android:gravity="center"
  android:orientation="horizontal">
  <Chronometer android:id="@+id/widget_compact_countdown"
   android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:text="--:--" android:textColor="#152821"
   android:textSize="10sp" android:textStyle="bold"
   android:singleLine="true" android:includeFontPadding="false"/>
 </LinearLayout>
</LinearLayout>
