  android:orientation="horizontal" android:gravity="center">
 <ImageView android:id="@+id/widget_col_icon_1" android:layout_width="12dp" android:layout_height="12dp"
  android:src="@drawable/widget_ic_gunes" android:tint="#F0C97F" android:scaleType="fitCenter"
  android:contentDescription="Güneş"/>
 <TextView android:id="@+id/widget_col_label_1" android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:layout_marginStart="3dp" android:text="Güneş" android:textSize="12sp" android:textColor="#F1F7F8"
  android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_col_time_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.54" android:text="--:--" android:textSize="14sp" android:textColor="#F1F7F8" android:textStyle="bold" android:gravity="center" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_col_cell_2" android:layout_width="match_parent" android:layout_height="0dp"
  android:layout_weight="1" android:layout_marginTop="4dp" android:paddingStart="3dp" android:paddingEnd="3dp"
  android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_cell_dark">
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.46"
  android:orientation="horizontal" android:gravity="center">
 <ImageView android:id="@+id/widget_col_icon_2" android:layout_width="12dp" android:layout_height="12dp"
  android:src="@drawable/widget_ic_ogle" android:tint="#F0C97F" android:scaleType="fitCenter"
  android:contentDescription="Öğle"/>
 <TextView android:id="@+id/widget_col_label_2" android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:layout_marginStart="3dp" android:text="Öğle" android:textSize="12sp" android:textColor="#F1F7F8"
  android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_col_time_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.54" android:text="--:--" android:textSize="14sp" android:textColor="#F1F7F8" android:textStyle="bold" android:gravity="center" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_col_cell_3" android:layout_width="match_parent" android:layout_height="0dp"
  android:layout_weight="1" android:layout_marginTop="4dp" android:paddingStart="3dp" android:paddingEnd="3dp"
  android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_cell_dark">
