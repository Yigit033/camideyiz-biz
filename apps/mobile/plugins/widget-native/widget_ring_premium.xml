 android:background="@drawable/widget_row_clear">
  <TextView android:id="@+id/widget_ring_premium_label_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="İkindi" android:textColor="#B2C6D6" android:textSize="9sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />

  <TextView android:id="@+id/widget_ring_premium_clock_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--:--" android:textColor="#F2F7FB" android:textSize="10sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="3dp" android:textStyle="bold"/>

 </LinearLayout>
<LinearLayout android:id="@+id/widget_ring_premium_cell_4"
 android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
 android:gravity="center" android:orientation="vertical" android:padding="1dp"
 android:background="@drawable/widget_row_clear">
  <TextView android:id="@+id/widget_ring_premium_label_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Akşam" android:textColor="#B2C6D6" android:textSize="9sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />

  <TextView android:id="@+id/widget_ring_premium_clock_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--:--" android:textColor="#F2F7FB" android:textSize="10sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="3dp" android:textStyle="bold"/>

 </LinearLayout>
<LinearLayout android:id="@+id/widget_ring_premium_cell_5"
 android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
 android:gravity="center" android:orientation="vertical" android:padding="1dp"
 android:background="@drawable/widget_row_clear">
  <TextView android:id="@+id/widget_ring_premium_label_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Yatsı" android:textColor="#B2C6D6" android:textSize="9sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />

  <TextView android:id="@+id/widget_ring_premium_clock_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--:--" android:textColor="#F2F7FB" android:textSize="10sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="3dp" android:textStyle="bold"/>

 </LinearLayout>

 </LinearLayout>
</LinearLayout>
