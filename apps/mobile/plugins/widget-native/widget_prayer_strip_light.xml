<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_strip_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg_light">

  <!-- Six real prayer times in the four-column launcher widget footprint.
       Each entry receives one-sixth of the available width, not a launcher cell. -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingTop="6dp"
      android:paddingBottom="6dp"
      android:paddingStart="5dp"
      android:paddingEnd="5dp"
      android:baselineAligned="false"
      android:background="@drawable/widget_strip_header_light">
      <LinearLayout
        android:id="@+id/widget_strip_cell_0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="1dp"
        android:paddingEnd="1dp"
        android:background="@drawable/widget_row_clear">
        <TextView
          android:id="@+id/widget_strip_label_0"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:text="—"
          android:textSize="10sp"
          android:textColor="#365C78"
          android:maxLines="1"
          android:ellipsize="end"
          android:includeFontPadding="false"/>
        <TextView
          android:id="@+id/widget_strip_time_0"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="5dp"
          android:gravity="center"
          android:text="--:--"
          android:textSize="13sp"
          android:textStyle="bold"
          android:textColor="#1B415B"
          android:maxLines="1"
          android:includeFontPadding="false"/>
      </LinearLayout>
      <LinearLayout
        android:id="@+id/widget_strip_cell_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="1dp"
        android:paddingEnd="1dp"
        android:background="@drawable/widget_row_clear">
        <TextView
          android:id="@+id/widget_strip_label_1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:text="—"
          android:textSize="10sp"
          android:textColor="#365C78"
          android:maxLines="1"
          android:ellipsize="end"
          android:includeFontPadding="false"/>
        <TextView
          android:id="@+id/widget_strip_time_1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="5dp"
          android:gravity="center"
          android:text="--:--"
          android:textSize="13sp"
          android:textStyle="bold"
          android:textColor="#1B415B"
          android:maxLines="1"
          android:includeFontPadding="false"/>
      </LinearLayout>
      <LinearLayout
        android:id="@+id/widget_strip_cell_2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="1dp"
        android:paddingEnd="1dp"
        android:background="@drawable/widget_row_clear">
        <TextView
          android:id="@+id/widget_strip_label_2"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:text="—"
          android:textSize="10sp"
          android:textColor="#365C78"
          android:maxLines="1"
          android:ellipsize="end"
          android:includeFontPadding="false"/>
        <TextView
          android:id="@+id/widget_strip_time_2"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="5dp"
          android:gravity="center"
          android:text="--:--"
          android:textSize="13sp"
          android:textStyle="bold"
          android:textColor="#1B415B"
          android:maxLines="1"
          android:includeFontPadding="false"/>
      </LinearLayout>
      <LinearLayout
        android:id="@+id/widget_strip_cell_3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="1dp"
        android:paddingEnd="1dp"
        android:background="@drawable/widget_row_clear">
        <TextView
          android:id="@+id/widget_strip_label_3"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:text="—"
          android:textSize="10sp"
          android:textColor="#365C78"
          android:maxLines="1"
          android:ellipsize="end"
          android:includeFontPadding="false"/>
        <TextView
          android:id="@+id/widget_strip_time_3"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="5dp"
          android:gravity="center"
          android:text="--:--"
          android:textSize="13sp"
          android:textStyle="bold"
          android:textColor="#1B415B"
          android:maxLines="1"
          android:includeFontPadding="false"/>
      </LinearLayout>
      <LinearLayout
        android:id="@+id/widget_strip_cell_4"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="1dp"
        android:paddingEnd="1dp"
        android:background="@drawable/widget_row_clear">
        <TextView
          android:id="@+id/widget_strip_label_4"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:text="—"
          android:textSize="10sp"
          android:textColor="#365C78"
          android:maxLines="1"
          android:ellipsize="end"
          android:includeFontPadding="false"/>
        <TextView
          android:id="@+id/widget_strip_time_4"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="5dp"
          android:gravity="center"
          android:text="--:--"
          android:textSize="13sp"
          android:textStyle="bold"
          android:textColor="#1B415B"
          android:maxLines="1"
          android:includeFontPadding="false"/>
      </LinearLayout>
      <LinearLayout
        android:id="@+id/widget_strip_cell_5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="1dp"
        android:paddingEnd="1dp"
        android:background="@drawable/widget_row_clear">
        <TextView
          android:id="@+id/widget_strip_label_5"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:text="—"
          android:textSize="10sp"
          android:textColor="#365C78"
          android:maxLines="1"
          android:ellipsize="end"
          android:includeFontPadding="false"/>
        <TextView
          android:id="@+id/widget_strip_time_5"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="5dp"
          android:gravity="center"
          android:text="--:--"
          android:textSize="13sp"
          android:textStyle="bold"
          android:textColor="#1B415B"
          android:maxLines="1"
          android:includeFontPadding="false"/>
      </LinearLayout>
  </LinearLayout>

  <!-- Two-line native countdown. No network polling, React timer or
       fabricated kerahat interval. The original owned 3D mark stays visible. -->
  <LinearLayout
      android:id="@+id/widget_strip_remaining_row"
      android:layout_width="match_parent"
      android:layout_height="55dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="12dp"
      android:paddingEnd="11dp"
      android:background="@drawable/widget_strip_footer_light">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">
      <TextView
          android:id="@+id/widget_strip_next"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="Takvim bekleniyor"
          android:textColor="#65736C"
          android:textSize="11sp"
          android:maxLines="1"
          android:ellipsize="end"
          android:includeFontPadding="false"/>
      <Chronometer
          android:id="@+id/widget_strip_countdown"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:text="--:--"
          android:textColor="#152821"
          android:textSize="19sp"
          android:textStyle="bold"
          android:fontFamily="sans-serif"
          android:singleLine="true"
          android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="69dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:orientation="vertical"
        android:gravity="center">
      <ImageView
          android:layout_width="31dp"
          android:layout_height="20dp"
          android:src="@drawable/widget_brand_symbol"
          android:contentDescription="Camideyiz Biz orijinal logosu"
          android:scaleType="fitCenter"/>
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:gravity="center"
          android:text="Camideyiz Biz"
          android:textSize="8sp"
          android:textStyle="bold"
          android:textColor="#152821"
          android:maxLines="1"
          android:includeFontPadding="false"/>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
