# Public URL of our own Diyanet server, after official access approval.
EXPO_PUBLIC_PRAYER_API_URL=
# Camiler does not need a Google API key or a server URL.

# In the absence of this URL, the app uses the public no-key Idamedya calendar.
# Source: https://idamedya.org/api/ . Not the official Diyanet REST API.
# Public source has an approximate 1h caching permission and may rate-limit.

# Optional anonymous announcement push subscriptions.
# PUBLIC: no secrets in Expo app bundles. Leave unset until admin backend,
# FCM/APNs credentials, migration, and secured cron are actually live.
EXPO_PUBLIC_CB_ANNOUNCEMENTS_API_URL=
EXPO_PUBLIC_CB_EAS_PROJECT_ID=
