# PUBLIC URL of apps/api server. Example development on a physical phone:
# EXPO_PUBLIC_MOSQUE_API_URL=http://192.168.1.100:3001
# Production requires HTTPS. This is NOT a Google key.
EXPO_PUBLIC_MOSQUE_API_URL=
# Diyanet API only after official Diyanet approval:
EXPO_PUBLIC_PRAYER_API_URL=
# Native Google Maps build keys are NOT EXPO_PUBLIC. Configure at EAS/CI:
# GOOGLE_MAPS_ANDROID_API_KEY=   (Android package + signing certificate restriction)
# GOOGLE_MAPS_IOS_API_KEY=       (iOS bundle ID restriction)
