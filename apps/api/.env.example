# Private Diyanet server variables — never publish or bundle in Expo.
DIYANET_EMAIL=
DIYANET_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PRAYER_SYNC_SECRET=
CRON_SECRET=

# Private, owner-controlled scheduled broadcasts. Off by default.
# Enable only after SQL migration and Expo FCM/APNs credentials are installed.
CB_ANNOUNCEMENTS_ENABLED=false
# Minimum 48 chars, server ONLY. Do NOT put in EXPO_PUBLIC vars.
CB_ANNOUNCEMENT_ADMIN_SECRET=
# Minimum 32 chars, HMAC salt for rate-limiting pseudonymous IP hashes.
CB_PUSH_IP_HASH_SECRET=
# Optional server-only Expo access token if Expo push access control is enabled.
CB_EXPO_ACCESS_TOKEN=
# CRON_SECRET (declared above) must be >=48 chars for this new dispatch route.
