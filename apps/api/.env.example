# Private server environment: only apps/api, never Expo or GitHub.
DIYANET_EMAIL=
DIYANET_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Two different random 32+ character secrets:
PRAYER_SYNC_SECRET=
CRON_SECRET=

# GOOGLE PLACES (New) server key: restrict to Places API (New), separate
# from Android/iOS Maps SDK keys. Enable Google Cloud billing + quotas.
GOOGLE_PLACES_API_KEY=

# Explicit switch; prevents accidental billed Google Places requests.
GOOGLE_PLACES_API_ENABLED=false
